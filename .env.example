STORAGE_MODE=file
DATABASE_URL=postgresql://aeo:aeo_local@localhost:5432/aeo
# Local, single-user MVP. Do not expose publicly without authentication.

# Server-only credential. Leave blank to disable real measurement.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
AEO_MAX_QUESTIONS=1
AEO_MAX_OUTPUT_TOKENS=2000
AEO_MAX_TOOL_CALLS=1
AEO_DAILY_CALL_LIMIT=10
# Optional admin-provided rates. Blank means unknown, never zero cost.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
OPENAI_WEB_SEARCH_USD_PER_CALL=
LIVE_AI_ENABLED=false
FREE_GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_DAILY_LIMIT=2
